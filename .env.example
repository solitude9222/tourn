SELLAUTH_SHOP_URL=https://yourstore.com
SELLAUTH_PREMIUM_PRODUCT_ID=
SELLAUTH_1C_PRODUCT_ID=
SELLAUTH_SPECIAL_PRODUCT_ID=
SELLAUTH_BADGE_PRODUCT_ID=
# variantId -> { productId, handle } for username stock sold through SellAuth.
SELLAUTH_USERNAME_VARIANTS={}
# variantId -> { productId, badge } where badge is a catalogue id (founder, early-supporter…).
SELLAUTH_BADGE_VARIANTS={}
# Storefront > Configure > Miscellaneous (verifies delivery webhooks server-side).
SELLAUTH_WEBHOOK_SECRET=

