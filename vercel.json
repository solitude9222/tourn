{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://tourn-production.up.railway.app/api/:path*"
    },
    {
      "source": "/env.js",
      "destination": "https://tourn-production.up.railway.app/env.js"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
