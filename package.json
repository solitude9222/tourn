{
  "name": "tourn.lol",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/prepare-home-preview.mjs && tsc --noEmit && vite build",
    "deploy:cloudflare": "npm run build && npx wrangler pages deploy dist --project-name tourn",
    "server": "npm --prefix backends run dev",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:frontend": "node tests/frontend-regressions.mjs",
    "test:discord": "node --test tests/discord-automation.test.mjs",
    "test:data-transfer": "node --test tests/data-transfer.test.mjs",
    "test:audio": "node --test tests/audio.test.mjs",
    "test:analytics": "node --test tests/analytics.test.mjs"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "playwright-core": "^1.64.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "terser": "^5.51.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
